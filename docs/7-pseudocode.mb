	gameLogic(user1, user2){
		if user1.move is rock and user2 is scissors or
		if user1.move is paper and user2 is rock or 
		if user1.move is scissors and user2 is paper
			change user1.isWinning to true and change user2.isWinning to false
		if user2.move is rock and user1 is scissors or
		if user2.move is paper and user1 is rock or 
		if user2.move is scissors and user1 is paper
			change the user1.isWinning to false and user2.isWinning to true
		else
			change user1.isWinning and user2.isWinning to false
};

	updateScoreboard(user1,user2){
		if user1.isWinning is true add one to scoreboard.win
		if user2.isWinning is ture add one to scoreboard.lost
		else add one to scoreboard.tie
	};

	displayUi(user1,user2, scoreboard){
		if user1.isWinning is true display the HTML element for user 1 won and scoreboard
		if user2.isWinning is true display the HTML element for user 2 won and scoreboard
		if user1.isWinning and user2.isWinning is false display HTML Element for tir game and scoreboard
	};
	


	clearScore();| reset the scoreboard | input(ClearButton)|ouput = none


	saveScore(); | save the score of the game| input = the score| output = none
	
displayScore(){
