* Display Score board on the screen



addEventListener 'click', (event)
	if event.target.classList.contains.buttonRock user1Pick(user1, 'rock')
	if .buttonPaper userPick(user1, 'paper')
	if .buttonScissors userPick(user1, 'scissors)

	if event.target.classList.contains(.autoplay)
		change isrunning to = !isrunning
	if isRunning == false
		then set globalID to intervalID
		then clearInterval(globalID)
	if isRunning then setInterval(user1Pick(user1, randomPick()), 1000)

addEventListener 'keydown', (event)
		if event.key is 'r' user1Pick(user1, 'rock')
		if event.key is 'p' userPick(user1, 'paper')
		if event.key is 's' userPick(user1, 'scissors') 


	randomPick(){
		create a variable  with random number in it 
		create a move variable
		if number is <= 1/3 pick move = rock
		if number is > 1/3 and < 2/3 move = paper
		if number is >= 2/3 move = scissors
		return move;
	}; 

	user1Pick(user1, move){
		user1.move = move
		user2Pick(); this updateuser2 move to a random move to user2 
		gameLogic(user1, user2); this update who the winner is
		updateScoreboard(user1, user2); update the score 
		saveScore(scoreboard); this save the score to the localStorage
		displayUi(user1, user2, scoreboard); this take the information from user1 user2 and scoreboard and display it on the screen
	};

	user2Pick(user2){
		 save randomPick function to move variable
		update user2.move to move
	};

	gameLogic(user1, user2){
		if user1.move is rock and user2.move is scissors or
		if user1.move is paper and user2.move is rock or 
		if user1.move is scissors and user2.move is paper
			change user1.isWinning to true and change user2.isWinning to false
		if user2.move is rock and user1.move is scissors or
		if user2.move is paper and user1.move is rock or 
		if user2.move is scissors and user1.move is paper
			change the user1.isWinning to false and user2.isWinning to true
		else
			change user1.isWinning and user2.isWinning to false
};

//revised gameLogic
gameLogic(user1, user2){
    IF user1.move == user2.move THEN
        user1.isWinning = false
        user2.isWinning = false
    ELSE IF user1.move is rock AND user2.move is scissors OR
            user1.move is paper AND user2.move is rock OR 
            user1.move is scissors AND user2.move is paper THEN
        user1.isWinning = true
        user2.isWinning = false
    ELSE
        user1.isWinning = false
        user2.isWinning = true
};

	updateScoreboard(user1,user2){
		if user1.isWinning is true add one to scoreboard.win
		if user2.isWinning is ture add one to scoreboard.lost
		else add one to scoreboard.tie
	};

	displayUi(user1,user2, scoreboard){
		if user1.isWinning is true display the HTML element for user 1 won and scoreboard
		if user2.isWinning is true display the HTML element for user 2 won and scoreboard
		if user1.isWinning and user2.isWinning is false display HTML Element for tie game and scoreboard
	};
	

	clearScore(clearButton){
		scoreboard.win set to 0
		scoreboard.lost set to 0
		scoreboard.tie set to 0
		saveScoreboard();
		display();
	};


	saveScore(scoreBoard){
		setLocalStorage(scoreboard)
	};
	
displayScore(){
		get the information for localstorage
		update the scoreboard
		displayUi();
	}; | pull the score from locoal storage| input = none| output = the score






